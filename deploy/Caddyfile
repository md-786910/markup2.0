# HTTPS and routing. Domains come from deploy/.env.
# The whole API domain goes to the server (the website proxy needs it).

{$API_URL} {
	encode zstd gzip
	reverse_proxy server:5000
}

{$APP_URL} {
	encode zstd gzip
	reverse_proxy client:8080
}

{$ADMIN_URL} {
	encode zstd gzip
	reverse_proxy admin:8080
}

{$SITE_URL} {
	encode zstd gzip
	reverse_proxy website:8080
}
