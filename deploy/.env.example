# Copy to deploy/.env (gitignored) and use long random values:
#   openssl rand -hex 24   (hex: no characters that need escaping in URLs)

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_DB=markup_mvp
MONGO_APP_USER=kommently
MONGO_APP_PASSWORD=
MONGO_PORT=27017
MONGO_CACHE_GB=1

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Encrypts every backup file. Store it in your password manager: without it
# the backups can't be restored.
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_DAYS=7
BACKUP_KEEP=8
BACKUP_DIR=./backups
# Host user/group that owns the (0600) backup files; run `id -u` / `id -g`
BACKUP_UID=0
BACKUP_GID=0
UPLOADS_DIR=../server/uploads
