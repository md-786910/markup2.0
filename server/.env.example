# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
NODE_ENV=production
PORT=5000
# With deploy/docker-compose.yml use the least-privilege app user, see deploy/README.md
MONGODB_URI=mongodb://kommently:<password>@127.0.0.1:27017/markup_mvp?authSource=markup_mvp
# At least 32 random characters (server refuses to start otherwise)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Redis (optional, recommended in production) ---
# Enables: persistent email queue with retries, shared rate limits, socket.io
# across instances, and a single daily billing job across instances.
# Unset = in-memory fallbacks (single instance only).
REDIS_URL=redis://:<password>@127.0.0.1:6379

# --- Origins / CORS ---
CLIENT_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://admin.example.com
WEBSITE_ORIGIN=https://www.example.com
CORS_ORIGIN=https://app.example.com
# Optional comma-separated extra origins
ALLOWED_ORIGINS=

# --- Website proxy ---
# Cloudflare Worker relay (cloudflare-relay/)
FALLBACK_RELAY_URL=
# Shared secret so only this server's pages can use the relay. Set the same value
# on the worker: cd cloudflare-relay && npx wrangler secret put RELAY_SECRET
RELAY_SECRET=
# Optional outbound HTTP proxy for sites that block the server
OUTBOUND_PROXY=
# Allow proxying private/localhost addresses. Development only, never in production.
PROXY_ALLOW_PRIVATE=false
# Largest upstream response the proxy will load, and memory for cached rewritten CSS/JS
PROXY_MAX_BYTES=52428800
PROXY_REWRITE_CACHE_BYTES=67108864

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kommently <no-reply@example.com>"
EMAIL_BATCH_DELAY_MS=300000
# First retry delay for a failed email send (doubles per attempt, 6 attempts). Redis only.
EMAIL_RETRY_BASE_MS=60000
EMAIL_LOGO_URL=
# Physical address shown in every email footer (required for commercial email)
COMPANY_POSTAL_ADDRESS=
# Public URL of this API, used in unsubscribe links (defaults to CLIENT_ORIGIN)
API_PUBLIC_URL=https://api.example.com

# --- Billing ---
# Run the daily billing/trial job inside the server (02:00 UTC by default).
# With REDIS_URL: safe on every instance (runs once). Without Redis: enable on
# exactly ONE instance. Or use `npm run billing` from a crontab instead (not both).
BILLING_CRON_ENABLED=false
BILLING_CRON=0 2 * * *
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# INR price used when a plan has no explicit INR price (Admin → Pricing)
RAZORPAY_USD_INR_RATE=84

# --- Tax invoices (seller details printed on every invoice) ---
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_STATE=
SELLER_COUNTRY=India
SELLER_EMAIL=
# GSTIN turns on GST tax invoices for INR payments (prices are GST-inclusive)
SELLER_GSTIN=
GST_RATE=18
# Optional note on USD (export) invoices, e.g. "Supply meant for export under LUT without payment of IGST"
SELLER_EXPORT_NOTE=
# Invoice numbers: <PREFIX>-<financial year>-<sequence>, e.g. INV-2627-000001 (max 4 chars)
INVOICE_PREFIX=INV

# --- Error monitoring (Sentry). Leave SENTRY_DSN empty to disable. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# 0 = errors only; e.g. 0.1 to also sample 10% of requests for performance tracing
SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups ---
# Prefer the weekly encrypted sidecar in deploy/docker-compose.yml. These are
# only for scripts/backup.sh when MongoDB isn't run with that compose file.
BACKUP_DIR=/var/backups/kommently
BACKUP_RETENTION_DAYS=14
