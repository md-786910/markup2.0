# Kommently configuration
# Copy to .env in the repository root. Read by Docker Compose, the server,
# server scripts and the frontend image builds.
# Passwords: 10+ random letters and digits (no symbols, they break connection URLs):
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 10
# JWT_SECRET must be at least 32 characters.

# Public URLs (no trailing slash). The API requires its own domain.
# Live:
API_URL=https://api.kommently.info
APP_URL=https://app.kommently.info
ADMIN_URL=https://admin.kommently.info
SITE_URL=https://kommently.info
# Local machine (Docker, no web server in front):
# API_URL=http://localhost:5000
# APP_URL=http://localhost:8081
# ADMIN_URL=http://localhost:8082
# SITE_URL=http://localhost:8083
# Additional allowed browser origins, comma-separated
EXTRA_CORS_ORIGINS=

# Local ports (127.0.0.1 only). Dev mode uses all four; in production only the
# API listens; after changing API_PORT run: sudo sh deploy/nginx/apply-env.sh
API_PORT=5000
APP_PORT=8081
ADMIN_PORT=8082
SITE_PORT=8083

# Release
IMAGE_TAG=latest
# Server worker processes (one per CPU core, max 4 by default). Requires Redis.
WEB_CONCURRENCY=
# Logs: level debug | info | warn | error; format pretty (colored, one line)
# or json (for log collectors)
LOG_LEVEL=info
LOG_FORMAT=pretty

# Database and cache
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
# Host ports for local access (change if already in use)
MONGO_PORT=27017
REDIS_PORT=6379
# Used only when the server runs outside Docker
MONGODB_URI=mongodb://kommently:<MONGO_APP_PASSWORD>@127.0.0.1:27017/markup_mvp?authSource=markup_mvp
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379
BACKUP_PASSPHRASE=

# Authentication (JWT_SECRET: minimum 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Encrypts two-step sign-in secrets in the database (any long random string).
# Set it once and never change it: a new key makes existing 2FA setups unreadable.
# Empty = derived from JWT_SECRET (then rotating JWT_SECRET resets everyone's 2FA).
TWO_FACTOR_KEY=
# Admin panel accounts must turn on two-step sign-in before they can use it.
# Always on unless set to false (only for a local machine).
ADMIN_REQUIRE_2FA=
# How long an admin panel session lasts (customer sessions use JWT_EXPIRES_IN)
ADMIN_SESSION_TTL=12h

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kommently <no-reply@kommently.info>"
COMPANY_POSTAL_ADDRESS=
# Optional email header logo (PNG; SVG is blocked by many mail apps), e.g. https://kommently.app/brand/kommently-logo.png
EMAIL_LOGO_URL=
# Inbox for the website contact form (default: the SMTP_FROM address)
SUPPORT_EMAIL=

# Website proxy
FALLBACK_RELAY_URL=
RELAY_SECRET=
PROXY_ALLOW_PRIVATE=false

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: Razorpay subscription plan IDs (scripts/setup_razorpay_plans.js)
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=

# Invoices (seller details; SELLER_GSTIN enables GST invoices)
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_STATE=
SELLER_COUNTRY=India
SELLER_EMAIL=
SELLER_GSTIN=

# Error monitoring
SENTRY_DSN=
CLIENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=testing
# Optional: deploy id shown on each error (e.g. the git commit); applies to the
# server and, on the next --build, the app
SENTRY_RELEASE=
# Optional: share of requests traced for performance (0 = off, e.g. 0.1)
SENTRY_TRACES_SAMPLE_RATE=0
# Optional: share of sessions profiled (CPU profiles of traced requests; 0 = off)
SENTRY_PROFILE_SAMPLE_RATE=0
# Lowest app log level forwarded to Sentry Logs: debug | info | warn | error
SENTRY_LOG_LEVEL=warn

# Product analytics for the app (PostHog; empty = off). Project API key and
# region host: https://eu.i.posthog.com or https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Live chat on the website and in the app (Crisp website ID, crisp.chat → Settings → Website settings → Setup). Empty = off
CRISP_WEBSITE_ID=
# Google Analytics 4 for the marketing website (empty = off); only stores
# data after the visitor accepts analytics cookies
GA_MEASUREMENT_ID=G-SY9B4Z0FJY
