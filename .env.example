# Kommently configuration
# Copy to .env in the repository root. Read by Docker Compose, the server,
# server scripts and the frontend image builds.
# Passwords: 10+ random letters and digits (no symbols, they break connection URLs):
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 10
# JWT_SECRET must be at least 32 characters.

# Public URLs (no trailing slash). The API requires its own domain.
# Live:
API_URL=https://api.kommently.info
APP_URL=https://app.kommently.info
ADMIN_URL=https://admin.kommently.info
SITE_URL=https://kommently.info
# Local machine (Docker, no web server in front):
# API_URL=http://localhost:5000
# APP_URL=http://localhost:8081
# ADMIN_URL=http://localhost:8082
# SITE_URL=http://localhost:8083
# Additional allowed browser origins, comma-separated
EXTRA_CORS_ORIGINS=

# Local ports (127.0.0.1 only). Dev mode uses all four; in production only the
# API listens and nginx proxies api. to it (deploy/nginx/kommently.conf).
API_PORT=5000
APP_PORT=8081
ADMIN_PORT=8082
SITE_PORT=8083

# Release
IMAGE_TAG=latest
# Server worker processes (one per CPU core, max 4 by default). Requires Redis.
WEB_CONCURRENCY=

# Database and cache
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
# Host ports for local access (change if already in use)
MONGO_PORT=27017
REDIS_PORT=6379
# Used only when the server runs outside Docker
MONGODB_URI=mongodb://kommently:<MONGO_APP_PASSWORD>@127.0.0.1:27017/markup_mvp?authSource=markup_mvp
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379
BACKUP_PASSPHRASE=

# Authentication (JWT_SECRET: minimum 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kommently <no-reply@kommently.info>"
COMPANY_POSTAL_ADDRESS=

# Website proxy
FALLBACK_RELAY_URL=
RELAY_SECRET=
PROXY_ALLOW_PRIVATE=false

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional: Razorpay subscription plan IDs (scripts/setup_razorpay_plans.js)
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=

# Invoices (seller details; SELLER_GSTIN enables GST invoices)
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_STATE=
SELLER_COUNTRY=India
SELLER_EMAIL=
SELLER_GSTIN=

# Error monitoring
SENTRY_DSN=
CLIENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=testing
