# API base URL, including /api
REACT_APP_BASE_URL=https://api.example.com/api
# Server origin (socket.io, uploads)
REACT_APP_SERVER_URL=https://api.example.com
# Error monitoring (Sentry, browser project DSN). Leave empty to disable.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
REACT_APP_SENTRY_RELEASE=
